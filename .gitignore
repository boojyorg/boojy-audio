# Rust
/engine/target/
**/*.rs.bk
Cargo.lock
/ui/macos/Runner/libengine.dylib

# Flutter
/ui/.dart_tool/
/ui/.flutter-plugins
/ui/.flutter-plugins-dependencies
/ui/.packages
/ui/build/
/ui/pubspec.lock

# macOS
/ui/macos/Flutter/ephemeral/
*.xcworkspace
# …but the macOS Runner workspace must be tracked — Flutter needs it to build the
# macOS app (CI failed with "No macOS desktop project configured" without it).
# Track only contents.xcworkspacedata; keep xcuserdata/ and the SwiftPM state ignored.
!/ui/macos/Runner.xcworkspace/
/ui/macos/Runner.xcworkspace/*
!/ui/macos/Runner.xcworkspace/contents.xcworkspacedata
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code — track shared config/rules/hooks/skills; ignore local-only files
**/.claude/settings.local.json
.claude/scheduled_tasks.lock

# Generated FFI
/ui/lib/bridge_generated.dart
/engine/bridge/src/bridge_generated.rs

# Audio cache & temp files
*.wav~
*.mp3~
cache/
.audio/

# OS
.DS_Store
Thumbs.db

# Docs
docs/private/
docs/dogfood/

engine/vst3_host/build/
engine/vst3_host/build_win/
engine/build_vst3/
engine/vst3_host/build_vst3/
engine/vst3_host/*.o
engine/vst3_host/.cache/
ui/macos/*.py
ui/macos/libengine.dylib
ui/macos/Frameworks/

# Third-party SDKs (cloned separately)
engine/vst3sdk/

# CocoaPods
/ui/macos/Pods/

